#!/bin/sh
# Only fire on branch checkouts, not file checkouts
[ "$3" = "1" ] || exit 0

# Skip inside git worktrees (e.g. Claude Code sessions) — they each have a
# .git file rather than a .git directory
[ -f .git ] && exit 0

. "$(git rev-parse --show-toplevel)/scripts/kill-port.sh"
kill_port 5173

nohup npm run dev > /tmp/vite-dev.log 2>&1 &
echo "Dev server starting on http://localhost:5173 (log: /tmp/vite-dev.log)"
